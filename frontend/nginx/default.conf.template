# Шаблон для envsubst штатного entrypoint nginx:alpine → /etc/nginx/conf.d/default.conf.
# Подставляются только GATEWAY_URL и NGINX_LOCAL_RESOLVERS (NGINX_ENVSUBST_FILTER в Dockerfile).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Адрес gateway резолвится на каждый запрос, а не при старте: nginx поднимается и
    # отдаёт SPA, даже если gateway остановлен или пересоздан с новым IP
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Собственная проверка живости — не зависит от gateway и его соседей
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # /api/* → ${GATEWAY_URL}/*: префикс срезается, браузер ходит только на origin фронта
    location /api/ {
        set $gateway "${GATEWAY_URL}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Ассеты Vite с хэшем в имени — кэшируются надолго
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA-fallback: глубокие ссылки (/orders/<id>) отдают index.html, его не кэшируем
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
