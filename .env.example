# Скопируйте в .env: cp .env.example .env
# Все адреса и параметры стенда задаются только здесь.

# --- Образ ---
PYTHON_VERSION=3.12

# --- Общие ---
LOG_LEVEL=INFO
STAND_API_KEY=stand-secret-key
SHUTDOWN_GRACE_SECONDS=5
CONNECT_TIMEOUT_SECONDS=10
GRPC_DEFAULT_DEADLINE_SECONDS=5

# --- Порты на хосте ---
GATEWAY_PORT=8080
FRONTEND_PORT=3000
USERS_PORT=50051
CATALOG_PORT=50052
ORDERS_PORT=50053
SUPPORT_PORT=50054
NOTIFICATIONS_PORT=50055
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
# Mailpit: SMTP и веб-ящик/REST API (http://localhost:8025/mail/)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Postgres ---
POSTGRES_USER=stand
POSTGRES_PASSWORD=stand
POSTGRES_DB=stand
# Внутри compose хост — postgres; с хоста (тесты курса) — localhost
POSTGRES_DSN=postgresql://stand:stand@postgres:5432/stand

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=stand
RABBITMQ_PASSWORD=stand
# Внутри compose хост — rabbitmq; с хоста (тесты курса) — localhost
RABBITMQ_URL=amqp://stand:stand@rabbitmq:5672/

# --- Адреса соседей (подменяются моком в курсе) ---
# USERS_ADDR — gateway; CATALOG_ADDR — order-service и gateway; ORDERS_ADDR — support-service и gateway
USERS_ADDR=users:50051
CATALOG_ADDR=catalog:50052
ORDERS_ADDR=orders:50053
# NOTIFICATIONS_ADDR — клиенты журнала писем (тесты курса)
NOTIFICATIONS_ADDR=notifications:50055

# --- user-service ---
SESSION_TTL_S=3600
CONFIRM_CODE_TTL_S=900
SEED_SELLER_PASSWORD=seller-password

# --- catalog-service ---
IMPORT_MAX_ROWS=10000
STOCK_RESERVE_DELAY_MS=0

# --- order-service ---
FULFILLMENT_STEP_MS=2000
IDEMPOTENCY_TTL_S=86400

# --- support-service ---
SUPPORT_AGENT_DELAY_MS=1500
SUPPORT_IDLE_TIMEOUT_S=60

# --- notification-service ---
# SMTP-сервер для писем (в стенде — Mailpit); с хоста — localhost:MAILPIT_SMTP_PORT
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="Маркетплейс-стенд <noreply@stand.local>"

# --- gateway ---
# HTTP внутри контейнера — 8080 (на хосте — GATEWAY_PORT); соседи — USERS_ADDR, CATALOG_ADDR, ORDERS_ADDR

# --- frontend ---
# nginx фронта проксирует /api/* на GATEWAY_URL/* (префикс срезается), поэтому CORS не нужен;
# внутри контейнера nginx слушает 80 (на хосте — FRONTEND_PORT)
GATEWAY_URL=http://gateway:8080
